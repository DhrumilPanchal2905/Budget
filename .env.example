# ============================================================
# Budget Pro — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add the same keys in Project → Settings → Environment Variables.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser — they hold no secrets.
# ============================================================

# --- REQUIRED ------------------------------------------------
# MongoDB connection string (MongoDB Atlas in production, local Mongo or Atlas in dev)
# If the DB password has special characters, URL-encode them:  @ → %40   # → %23   : → %3A   / → %2F
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Database name (optional, default: budgetpro)
MONGODB_DB="budgetpro"

# Public base URL of the app (used for origin/CSRF checks and links in notifications)
# Local:      http://localhost:3000
# Production: https://budget.dhrumilpanchal.in
APP_URL="http://localhost:3000"

# Admin account(s). Emails listed here are always admins.
# ADMIN_PASSWORD: just open /login and sign in with ADMIN_EMAILS + ADMIN_PASSWORD —
# the admin account is created automatically on that first login (no registration needed).
# If the email already has an account, it is upgraded to admin on its next login (use that account's password).
# After the first login the password is stored hashed in the DB; change it from Settings.
# (CLI alternative:  npm run make-admin -- you@example.com)
ADMIN_EMAILS="you@example.com"
ADMIN_PASSWORD=""

# --- RECOMMENDED (production) --------------------------------
# Random secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (EMI reminders job).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# --- OPTIONAL: Web Push notifications ------------------------
# Generate a key pair with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@dhrumilpanchal.in"

# --- OPTIONAL: Pusher Channels (managed WebSockets) ----------
# Leave empty to use the built-in Server-Sent-Events realtime (works on Vercel with zero setup).
# Fill all four to switch realtime to true WebSockets via Pusher (free "Sandbox" plan is enough to start).
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# --- OPTIONAL ------------------------------------------------
# Session lifetime in days (default 7)
SESSION_DAYS="7"

# --- OPTIONAL: Angel AI ----------------------------------------
# Angel is ON for the Unlimited plan and all admins. Set to "false" to switch it off instantly.
ANGEL_ENABLED="true"

# --- OPTIONAL: performance ------------------------------------
# MongoDB connections per server instance (default 15). Lower it if Atlas warns about the connection limit.
MONGODB_POOL_SIZE="15"

# --- EMAIL (OTP verification on sign-up + password reset) -----
# Gmail: turn on 2-Step Verification, then create an App Password (Google Account → Security → App passwords).
# These are only the FALLBACK — an admin can change the sender any time in Admin → Settings → Email (no redeploy).
SMTP_USER="dhrumilpanchal295@gmail.com"
SMTP_PASS=""            # 16-character Gmail App Password (NOT your normal Gmail password)
MAIL_FROM_NAME="Budget Pro"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# --- SECURITY --------------------------------------------------
# Secret for the encrypted API channel + encrypting saved settings. Generate one long random value and never change it
# casually (changing it just makes open tabs renegotiate). If empty, CRON_SECRET / MONGODB_URI are used to derive it.
PAYLOAD_SECRET=""
# "true" = the API rejects any non-encrypted write request (only our own frontend can call it).
REQUIRE_ENCRYPTED_API="false"

# --- SEO (optional) ---------------------------------------------
# Paste the verification codes from Google Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
