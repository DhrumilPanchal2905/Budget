# # ============================================================
# # Budget Pro — environment variables
# # Copy to .env.local for local development:  cp .env.example .env.local
# # On Vercel, add the same keys in Project → Settings → Environment Variables.
# # NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser — they hold no secrets.
# # ============================================================

# # --- REQUIRED ------------------------------------------------
# # MongoDB connection string (MongoDB Atlas in production, local Mongo or Atlas in dev)
# # MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_URI="mongodb+srv://dhrumil2905:DhrumiL%4029@cluster0.x1bkfkf.mongodb.net/?retryWrites=true&w=majority"
# # Database name (optional, default: budgetpro)
# MONGODB_DB="budgetpro"

# # Public base URL of the app (used for origin/CSRF checks and links in notifications)
# # Local:      http://localhost:3000
# # Production: https://budget.dhrumilpanchal.in
# APP_URL="http://localhost:3000"

# # Comma-separated emails that become ADMIN automatically when they register.
# # (You can also promote an existing user with:  npm run make-admin -- you@example.com)
# # ADMIN_EMAILS="dhrumilpanchal295@gmail.com"
# ADMIN_EMAILS="dhrumilpanchal295@gmail.com"
# ADMIN_PASSWORD="12345678"

# # --- RECOMMENDED (production) --------------------------------
# # Random secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (EMI reminders job).
# # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=""

# # --- OPTIONAL: Web Push notifications ------------------------
# # Generate a key pair with:  npm run vapid
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@dhrumilpanchal.in"

# # --- OPTIONAL: Pusher Channels (managed WebSockets) ----------
# # Leave empty to use the built-in Server-Sent-Events realtime (works on Vercel with zero setup).
# # Fill all four to switch realtime to true WebSockets via Pusher (free "Sandbox" plan is enough to start).
# PUSHER_APP_ID=""
# PUSHER_SECRET=""
# NEXT_PUBLIC_PUSHER_KEY=""
# NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# # --- OPTIONAL ------------------------------------------------
# # Session lifetime in days (default 7)
# SESSION_DAYS="7"


MONGODB_URI=mongodb+srv://dhrumil2905:DhrumiL%4029@cluster0.x1bkfkf.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=budgetpro
APP_URL=https://budget.dhrumilpanchal.in
ADMIN_EMAILS=dhrumilpanchal295@gmail.com
ADMIN_PASSWORD=DhrumiL@29
CRON_SECRET=b28193f7f451ed8e6f0161e7871e26a25af9193435412393c507af0644694ae7
SESSION_DAYS=7
# --- EMAIL OTP (Gmail App Password; can also be set later in Admin → Settings → Email) ---
SMTP_USER=dhrumilpanchal295@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Budget Pro

# --- SECURITY: encrypted API channel ---
PAYLOAD_SECRET=1f924f095ed9c03a1066c1491003347b629b9e8832f2145a353384e2af946dec
REQUIRE_ENCRYPTED_API=false
